# Database - for development use SQLite, for production use PostgreSQL
# SQLite (easy local dev)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production recommended)
# DATABASE_URL="postgresql://user:password@localhost:5432/minekeys?schema=public"

# JWT Secret - change this in production!
JWT_SECRET="super-secret-jwt-key-change-in-production-12345"

# Personal admin account used by the seed route
ADMIN_NAME="Your Name"
ADMIN_USERNAME="your_username"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="use-a-strong-password"

# Telegram Admin Username - IMPORTANT: This is used for Buy Now -> Telegram flow
# Do not hardcode throughout code, use this env variable
# Example: minekeys_admin or @minekeys_admin ( @ will be stripped automatically)
TELEGRAM_ADMIN_USERNAME="minekeys_admin"
NEXT_PUBLIC_TELEGRAM_USERNAME="minekeys_admin"

# Social Links
TIKTOK_USERNAME="minekeys.kh"
NEXT_PUBLIC_TIKTOK_USERNAME="minekeys.kh"
FACEBOOK_PAGE_URL="https://facebook.com/minekeys"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/minekeys"

# Store
STORE_NAME="MineKeys"

# Optional: Cloudinary for image upload (if you want cloud storage instead of local /public/uploads)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Optional: Telegram Bot Token and Chat IDs for sending payment proof to Telegram
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_ADMIN_CHAT_ID="admin_chat_id"
TELEGRAM_GROUP_CHAT_ID="group_chat_id"  